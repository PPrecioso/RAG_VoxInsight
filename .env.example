# Gerador local (não exige chave de API). Necessita instalar o app Ollama e baixar o modelo.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# Alternativa na nuvem. A API tem cobrança própria, diferente da assinatura ChatGPT.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Apenas para reconstruir índice neural opcional. Backend lite é padrão.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
